  },
  "dependencies": {
    "@rarefriends/friendsdk": "file:rarefriends-friendsdk-0.1.4.tgz",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
