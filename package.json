{
  "name": "rareton",
  "version": "0.1.0",
  "private": true,
  "description": "Rareton - a cosy village walk for Rare Friends (FriendSDK v0.1.4)",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "friendsdk dev games/rareton --host 0.0.0.0 --port 4173",
    "build": "friendsdk build games/rareton",
